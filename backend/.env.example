# Copy to backend/.env to override defaults. All vars are optional.

# auto | cpu | mps | cuda:0
KD_DEVICE=auto
# Load models at startup instead of on first request (comma-separated: mini,small,base)
KD_PRELOAD_MODELS=
KD_CACHE_PATH=data/cache.sqlite3
# Origins allowed to call the API from a browser (only needed when frontend is on another origin)
KD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Lower if you run out of memory during backtests
KD_INFERENCE_BATCH_SIZE=32
# Live forecast track record (kept separate from the cache)
# KD_JOURNAL_PATH=data/journal.sqlite3
# Market replay game sessions
# KD_SIM_PATH=data/sim.sqlite3
